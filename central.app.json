{
  "$schema": "./node_modules/@oondemand/create-central-oon/schemas/central.app.schema.json",
  "schemaVersion": 1,
  "id": "doc-custom-multimoedas",
  "name": "Doc Custom Multimoedas",
  "slug": "doc-custom-multimoedas",
  "appKind": "member-central",
  "tenancyModel": "multi_tenant",
  "availability": "licensed",
  "accessMode": "explicit_users",
  "authorizationMode": "rbac",
  "deploymentMode": "shared",
  "modules": {
    "collections": true,
    "documents": true,
    "pipelines": true,
    "integrations": false,
    "omie": false,
    "assistants": false,
    "currencies": true
  },
  "capabilities": [
    "core.collections",
    "core.documents",
    "core.pipelines",
    "doc-custom.omie",
    "doc-custom.currencies",
    "doc-custom.templates",
    "doc-custom.email"
  ],
  "compatibility": {
    "core": {
      "minVersion": "0.3.45",
      "maxVersionExclusive": "0.5.0"
    }
  },
  "activation": {
    "enabled": true,
    "configurationVersion": 1,
    "fields": []
  },
  "rbac": {
    "invitationTtlHours": 72,
    "permissions": [
      "dashboard.read",
      "process.read",
      "process.approve",
      "process.send",
      "process.retry",
      "process.reprocess",
      "process.system",
      "bases.read",
      "bases.manage",
      "settings.read",
      "settings.manage",
      "currencies.read",
      "currencies.manage",
      "templates.read",
      "templates.manage",
      "triggers.read",
      "triggers.manage",
      "audit.read"
    ],
    "roles": [
      {
        "code": "admin",
        "name": "Administrador",
        "description": "Administra usuários, acessos e todas as operações da Central.",
        "admin": true,
        "permissions": ["*"]
      },
      {
        "code": "developer",
        "name": "Desenvolvedor",
        "description": "Compatibilidade com usuários ativados antes da definição dos perfis de negócio.",
        "permissions": ["*"]
      },
      {
        "code": "approver",
        "name": "Aprovador",
        "description": "Consulta processos e aprova ou rejeita o processamento e a fatura.",
        "permissions": ["dashboard.read", "process.read", "process.approve", "audit.read"]
      },
      {
        "code": "operator",
        "name": "Operador",
        "description": "Consulta processos, confirma o envio e executa retentativas permitidas.",
        "permissions": ["dashboard.read", "process.read", "process.send", "process.retry", "audit.read"]
      },
      {
        "code": "viewer",
        "name": "Consulta",
        "description": "Perfil base para acesso somente às consultas explicitamente permitidas.",
        "permissions": [
          "dashboard.read",
          "process.read",
          "bases.read",
          "settings.read",
          "currencies.read",
          "templates.read",
          "triggers.read",
          "audit.read"
        ]
      }
    ]
  }
}
