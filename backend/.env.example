OON_RUNTIME_MODE=local
NODE_ENV=development
HOST=127.0.0.1
# Identidade
SERVICE_NAME=doc-custom-multimoedas
SERVICE_VERSION=0.1.0
PORT=4000

# Banco
MONGO_URI=mongodb://localhost:27017/doc-custom-multimoedas

# Autenticacao e autorizacao pela Central de Ativacoes
# URL publica/frontend da Central de Ativacoes.
CENTRAL_ATIVACAO_URL=https://central-ativacao.central.oondemand.online
# URL canonica do backend/API da Central de Ativacoes.
CENTRAL_ATIVACAO_API_URL=https://central-ativacao.central.oondemand.online/api/
APP_CODE=doc-custom-multimoedas
AUTH_PROVIDER_TIMEOUT_MS=10000
# Compatibilidade temporaria: CENTRAL_ATIVACAO_BACKEND_URL, MEUS_APPS_BACKEND_URL e APP_KEY tambem sao aceitas.

DOC_CUSTOM_CREDENTIALS_ENCRYPTION_KEY=
PUBLIC_APP_URL=http://localhost:4000

# Limite adicional do artefato recebido da capability nativa do OonCore.
PDF_MAX_BYTES=20971520

# E-mail SendGrid
SENDGRID_API_KEY=
EMAIL_MAX_TOTAL_BYTES=20971520

# Limites defensivos
TEMPLATE_RENDER_TIMEOUT_MS=1500
TEMPLATE_MAX_OUTPUT_BYTES=5242880
IMAGE_MAX_BYTES=2097152
PROCESS_LOCK_MS=900000
