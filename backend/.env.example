# Identidade
SERVICE_NAME=doc-custom-multimoedas
SERVICE_VERSION=0.1.0
PORT=4000
NODE_ENV=development

# Banco
MONGO_URI=mongodb://localhost:27017/doc-custom-multimoedas

# Sessão local gerenciada pelo OonCore.
OON_RUNTIME_MODE=local

# Segredos de negocio (minimo 32 caracteres)
DOC_CUSTOM_CREDENTIALS_ENCRYPTION_KEY=
PUBLIC_APP_URL=http://127.0.0.1:4000

# Limite adicional do artefato recebido da capability nativa do OonCore.
PDF_MAX_BYTES=20971520

# E-mail SendGrid
SENDGRID_API_KEY=
EMAIL_MAX_TOTAL_BYTES=20971520

# Limites defensivos
TEMPLATE_RENDER_TIMEOUT_MS=1500
TEMPLATE_MAX_OUTPUT_BYTES=5242880
IMAGE_MAX_BYTES=2097152
PROCESS_LOCK_MS=900000
